{
  "name": "tentap-example-oldarch",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "cd android && ./gradlew assembleDebug --console=plain",
    "build:android:release": "cd android && ./gradlew assembleRelease --console=plain",
    "build:ios": "cd ios && xcodebuild -workspace exampleoldarch.xcworkspace -scheme exampleoldarch -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build CODE_SIGNING_ALLOWED=NO -quiet build",
    "build:ios:release": "cd ios && xcodebuild -workspace exampleoldarch.xcworkspace -scheme exampleoldarch -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build CODE_SIGNING_ALLOWED=NO -quiet build",
    "pods": "cd ios && bundle exec pod install",
    "typecheck": "tsc --noEmit",
    "e2e": "maestro test -e APP_ID=com.exampleoldarch ../examplelatest/.maestro"
  },
  "dependencies": {
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@types/react": "^18.2.6",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
