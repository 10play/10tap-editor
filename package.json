{
  "name": "@10play/tentap-editor",
  "version": "1.1.0",
  "description": "React Native Rich Text Editor",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./web": {
      "types": "./lib-web/typescript/webEditorUtils/index.d.ts",
      "import": "./lib-web/index.mjs",
      "require": "./lib-web/index.umd.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "lib-web",
    "scripts/buildEditor.js",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/src/test",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "editor:dev": "vite",
    "editor:build": "vite build && node ./scripts/buildEditor.js ./src/simpleWebEditor/build/index.html",
    "editor:build-web-utils": "rimraf lib-web && vite build --config ./src/webEditorUtils/vite.config.ts && tsc --project ./src/webEditorUtils",
    "example": "yarn workspace tentap-example",
    "example:expo": "yarn workspace tentap-example-expo",
    "e2e:web": "yarn workspace tentap-e2e-web test",
    "test": "jest",
    "test:web": "vitest run",
    "typecheck": "tsc --noEmit && tsc --project ./src/webEditorUtils --noEmit && tsc --project ./src/simpleWebEditor",
    "lint": "eslint .",
    "check:codegen": "node ./scripts/check-codegen.js",
    "check:bundle": "node ./scripts/check-isolated-bundle.js",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build example-expo/android example-expo/ios lib lib-web",
    "prepare": "bob build",
    "prepack": "yarn editor:build && yarn editor:build-web-utils && bob build",
    "release": "release-it"
  },
  "keywords": [
    "rich text",
    "rich text editor",
    "editor",
    "tiptap react-native",
    "prosemirror react-native",
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10play/10Tap-Editor.git"
  },
  "author": "Amir Angel <36531255+17Amir17@users.noreply.github.com> (https://www.10play.dev)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/10play/10Tap-Editor/issues"
  },
  "homepage": "https://github.com/10play/10Tap-Editor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.0",
    "@evilmartians/lefthook": "^1.13.6",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/codegen": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@release-it/conventional-changelog": "^5.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.7.0",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "pod-install": "^0.1.0",
    "prettier": "^3.6.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-native": "0.82.1",
    "react-native-builder-bob": "^0.40.13",
    "react-native-webview": "13.16.0",
    "react-test-renderer": "19.1.1",
    "release-it": "^15.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.3.6",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "prosemirror-model": "1.25.4",
    "prosemirror-state": "1.4.3",
    "prosemirror-view": "1.41.3",
    "prosemirror-transform": "1.10.5"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "workspaces": [
    "example",
    "example-expo",
    "e2e-web",
    "website"
  ],
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": ">=20.19"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version} [skip ci]",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@tiptap/core": "^3.11.0",
    "@tiptap/extension-blockquote": "^3.11.0",
    "@tiptap/extension-bold": "^3.11.0",
    "@tiptap/extension-code": "^3.11.0",
    "@tiptap/extension-color": "^3.11.0",
    "@tiptap/extension-document": "^3.11.0",
    "@tiptap/extension-hard-break": "^3.11.0",
    "@tiptap/extension-heading": "^3.11.0",
    "@tiptap/extension-highlight": "^3.11.0",
    "@tiptap/extension-image": "^3.11.0",
    "@tiptap/extension-italic": "^3.11.0",
    "@tiptap/extension-link": "^3.11.0",
    "@tiptap/extension-list": "^3.11.0",
    "@tiptap/extension-paragraph": "^3.11.0",
    "@tiptap/extension-strike": "^3.11.0",
    "@tiptap/extension-text": "^3.11.0",
    "@tiptap/extension-text-style": "^3.11.0",
    "@tiptap/extension-underline": "^3.11.0",
    "@tiptap/extensions": "^3.11.0",
    "@tiptap/pm": "^3.11.0",
    "@tiptap/react": "^3.11.0",
    "lodash": "^4.17.21"
  },
  "codegenConfig": {
    "name": "RNTenTapSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.tentap"
    },
    "ios": {
      "modulesProvider": {
        "TenTapKeyboard": "TenTapKeyboard"
      }
    }
  }
}
