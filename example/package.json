{
  "name": "tentap-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android && yarn reverse-android",
    "reverse-android": "adb reverse tcp:3000 tcp:3000",
    "pods": "cd ios && RCT_NEW_ARCH_ENABLED=1 pod install",
    "pods:oldarch": "cd ios && RCT_NEW_ARCH_ENABLED=0 pod install",
    "build:ios": "cd ios && xcodebuild -workspace TenTapExample.xcworkspace -scheme TenTapExample -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build CODE_SIGNING_ALLOWED=NO -quiet build",
    "build:ios:release": "cd ios && xcodebuild -workspace TenTapExample.xcworkspace -scheme TenTapExample -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build CODE_SIGNING_ALLOWED=NO -quiet build",
    "build:android": "cd android && ./gradlew assembleDebug --console=plain",
    "build:android:oldarch": "cd android && ./gradlew assembleDebug -PnewArchEnabled=false --console=plain",
    "build:android:release": "cd android && ./gradlew assembleRelease --console=plain",
    "editor:dev": "vite --config ./src/Examples/Advanced/editor-web/vite.config.ts",
    "editor:build": "vite --config ./src/Examples/Advanced/editor-web/vite.config.ts build && yarn editor:post-build",
    "editor:post-build": "node ../scripts/buildEditor.js ./src/Examples/Advanced/editor-web/build/index.html",
    "typecheck": "tsc --noEmit",
    "e2e": "maestro test .maestro",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@tiptap/core": "^3.11.0",
    "@tiptap/extension-character-count": "^3.11.0",
    "@tiptap/extension-document": "^3.11.0",
    "@tiptap/extension-paragraph": "^3.11.0",
    "@tiptap/extension-text": "^3.11.0",
    "@tiptap/extensions": "^3.11.0",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.18.0",
    "react-native-svg": "~15.15.0",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@tiptap/pm": "^3.11.0",
    "@tiptap/react": "^3.11.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.4",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-dom": "19.1.4",
    "react-test-renderer": "19.1.4",
    "typescript": "^5.8.3",
    "vite": "^5.0.12"
  },
  "engines": {
    "node": ">=20"
  }
}
